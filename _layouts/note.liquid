---
layout: default
---
<div class="post note-page">
  <article class="note-entry">
    <div class="note-content" id="markdown-content">
      {{ content }}
    </div>
    {% include note_meta.liquid note=page link=false %}
  </article>

  <nav class="note-nav">
    {% if page.previous %}
      <a href="{{ page.previous.url | relative_url }}">&larr; older</a>
    {% else %}
      <span></span>
    {% endif %}
    <a href="{{ '/notes/' | relative_url }}">all {{ site.notes_name }}</a>
    {% if page.next %}
      <a href="{{ page.next.url | relative_url }}">newer &rarr;</a>
    {% else %}
      <span></span>
    {% endif %}
  </nav>
</div>
